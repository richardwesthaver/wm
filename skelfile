:name "wm"
:author ""
:version "1.0.0"
:bind
((emacs-locals
  :dir-locals
  ((nil . ((indent-tabs-mode . nil)))
   (makefile-mode . ((indent-tabs-mode . t)))))
 (sbcl :env "/usr/local/bin/sbcl")
 (user-wm-dir :env (std:xdg-config-dir :wm)))
:vc (:hg "https://vc.compiler.company/shed/wm"
     (upstream (:git "https://github.com/stumpwm/stumpwm"))
     (gh (:git "ssh://git@github.com/richardwesthaver/wm")))
:stash ".stash"
:cache ".stash/cache"
:rules
((default (build))
 (build ()
  (with-sbcl (:noinform t :quit t :input t)
   (ql:quickload '(:std :stumpwm :modeline :util))
   (sb-ext:save-lisp-and-die 
    "wm" 
    :toplevel 
    (lambda ()
     (uiop:symbol-call :stumpwm "STUMPWM")
     (exit :code 0))
    :executable t
    :purify t
    :compression t)))
 (modules () (:install () #$mkdir -pv $USER_WM_DIR/contrib && cp -rf contrib/* $USER_WM_DIR/contrib/$#))
 (:install (install-modules)
  (with-sudo 
   "install -m 755 wm /usr/local/bin/"))
 (clean ()
  #$rm -f *.fasl *.fas *.lib *.*fsl
  rm -f *.log *.fns *.fn *.aux *.cp *.ky *.log *.toc *.pg *.tp *.vr *.vrs
  rm -f stumpwm$#))

