;;; wm @ 2025-06-27.22:38:10 -*- mode:skel; -*-
:name "wm"
:author ("Richard Westhaver" . "ellis@rwest.io")
:description "A fork of StumpWM by Shawn Betts <sabetts@vcn.bc.ca>"
:version "1.0.1"
:license "GPL"
:tags ("gui" "wm" "linux" "x")
:bind
((emacs-locals
  :dir-locals
  ((nil . ((indent-tabs-mode . nil)))
   (makefile-mode . ((indent-tabs-mode . t)))))
 (sbcl :env "/usr/local/bin/sbcl")
 (user-wm-dir :env (std:xdg-config-dir :wm)))
:vc (:hg "https://vc.compiler.company/shed/wm"
     (upstream (:git "https://github.com/stumpwm/stumpwm"))
     (gh (:git "ssh://git@github.com/richardwesthaver/wm"))
     (cb (:git "ssh://git@codeberg.org/c-c/wm")))
:stash ".stash"
:cache ".stash/cache"
:rules
((default (build))
 (build ()
  (with-core (:quit t :input t)
   (load-system :core)
   (xkb:load-xkbcommon) ; requires xkbcommon.so
   (load-system :vec)
   (load-system :vec/paths)
   (load-system :vec/paths/ttf)
   (load-system :xlib)
   (load-system :wm)
   (load-system :util)
   (load-system :modeline)
   (in-package :wm-user)
   ;; post-load hooks
   (sb-ext:save-lisp-and-die 
    ".stash/wm" 
    :toplevel (find-symbol "START-WM" :wm)
    :executable t
    :purify t
    :compression t)))
 (:install ()
  (with-sudo 
   "install -m 755 .stash/wm /usr/local/bin/"))
 (clean ()
  #$rm -f *.fasl *.fas *.lib *.*fsl
  rm -f *.log *.fns *.fn *.aux *.cp *.ky *.log *.toc *.pg *.tp *.vr *.vrs
  rm -f wm$#))

