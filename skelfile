;;; wm @ 2025-06-27.22:38:10 -*- mode:skel; -*-
:name "wm"
:author ("Richard Westhaver" . "ellis@rwest.io")
:description "A fork of StumpWM by Shawn Betts <sabetts@vcn.bc.ca>"
:version "1.0.1"
:license "GPL"
:tags ("gui" "wm" "linux" "x")
:bind
((emacs-locals
  :dir-locals
  ((nil . ((indent-tabs-mode . nil)))
   (makefile-mode . ((indent-tabs-mode . t)))))
 (sbcl :env "/usr/local/bin/sbcl")
 (user-wm-dir :env (std:xdg-config-dir :wm)))
:vc (:hg "https://vc.compiler.company/shed/wm"
     (upstream (:git "https://github.com/stumpwm/stumpwm"))
     (gh (:git "ssh://git@github.com/richardwesthaver/wm"))
     (cb (:git "ssh://git@codeberg.org/c-c/wm")))
:stash ".stash"
:cache ".stash/cache"
:rules
((default (build))
 (build ()
  (with-core (:quit t :input t)
   (load-system :core)
   (xkb:load-xkbcommon t) ; requires xkbcommon.so
   (load-system :vec)
   (load-system :vec/paths)
   (load-system :vec/paths/ttf)
   (load-system :xlib)
   (load-system :wm)
   (load-system :wm/util)
   (load-system :wm/modeline)
   (in-package :wm-user)
   ;; post-load hooks
   (log:remove-logger)
   (sleep 1)
   (sb-ext:save-lisp-and-die 
    ".stash/wm" 
    :toplevel (find-symbol "START-WM" :wm)
    :executable t
    :purify t
    :compression t)))
 (:install ()
  (with-sudo 
   "install -m 755 .stash/wm /usr/bin/"))
 (:test () (cli/tools:run-xvfb-run '("-d" ".stash/wm")))
 (clean ()
  #$rm -f *.fasl *.fas *.lib *.*fsl
  rm -f *.log *.fns *.fn *.aux *.cp *.ky *.log *.toc *.pg *.tp *.vr *.vrs
  rm -rf .stash$#)
 (docs ()
  (:build ()
   (load-sys "../vec/vec.sys")
   (load-system :vec/paths :force t)
   (load-system :vec/paths/ttf :force t)
   (load-system :vec/aa :force t)
   (load-system :vec/aa/misc :force t)
   (load-system :vec :force t)
   (load-sys "../xlib/xlib.sys")
   (load-system :xlib)
   (load-system :xlib/truetype)
   (load-sys "wm.sys")
   (load-system :wm :force t)
   (in-package :wm-user)
   (load-system :wm/util :force t)
   (load-system :wm/modeline :force t)
   (let ((*document-multi-file* t))
    (time (publish (project-documentation)
           :output #p".stash/api.org" 
           :parent "shed"
           ;; :info t 
           :setupfile "../../../clean.theme"))))))

